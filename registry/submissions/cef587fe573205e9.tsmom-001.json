    "horizon": "\uc911\uae30. \ub8e9\ubc31\uc740 20~250 \uac70\ub798\uc77c\uc774\uace0 \uc2e0\ud638\ub294 \ub9e4\uc77c \uac31\uc2e0\ub418\uc9c0\ub9cc, \ubd80\ud638\uac00 \ubc14\ub014 \ub54c\ub9cc \ud3ec\uc9c0\uc158\uc774 \ubc14\ub00c\ubbc0\ub85c \uc2e4\ud6a8 \ubcf4\uc720\uae30\uac04\uc740 \ub8e9\ubc31\uc5d0 \ube44\ub840\ud55c\ub2e4. \ub9ac\ubc38\ub7f0\uc2a4 \uc8fc\uae30\ub294 \uc77c\uac04.",
