# Copy to .env (git-ignored) and fill in. The repository is public:
# a committed key is a disclosed key.
#
# Claude's research container cannot reach any of these hosts (its egress policy
# refuses them), so the keys that matter in practice are the ones set as GitHub
# Actions **repository secrets**, which is where the fetch jobs run (ADR-0007).
# Settings -> Secrets and variables -> Actions -> New repository secret.
# Never paste a key into a chat, an issue, a PR or a commit: anything pasted is
# disclosed and has to be rotated.

# --- Korea -------------------------------------------------------------------
KRX_API_KEY=                  # 한국거래소 공공데이터. KOSPI/KOSDAQ 일별 시세
DART_API_KEY=                 # 금융감독원 DART. 공시·재무제표 (밸류·퀄리티 팩터의 전제)
ECOS_API_KEY=                 # 한국은행 ECOS. 금리·환율·거시

# --- United States -----------------------------------------------------------
FRED_API_KEY=                 # St. Louis Fed. 금리·거시
POLYGON_API_KEY=              # 미국 주식. 유료, 페이퍼트레이딩 단계에서 붙인다

# --- Brokers -----------------------------------------------------------------
# 한국투자증권 Open API. 주문을 낼 수 있는 자격증명이므로 시세·계좌 조회만 쓰고
# 주문 경로에는 연결하지 않는다. 실자본 전환은 G8 승인 사항이다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=                  # 계좌번호. 모의투자 계좌와 실계좌를 섞지 않는다
KIS_PAPER=1                   # 1 = 모의투자 도메인, 0 = 실거래 도메인

IBKR_ACCOUNT=
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=7497        # 7497 = paper, 7496 = live
QD_LIVE_TRADING=0             # only a human flips this, after gate G8
