__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.ruff_cache/

# State is machine-local and can contain positions: never committed.
state/*
!state/README.md

# Market data is licensed and large. The README that says what belongs here is not data,
# and neither are the snapshot manifests: those live in registry/snapshots/ and are the
# reproducibility record (ADR-0006).
/data/*
!/data/README.md
*.parquet
*.duckdb
